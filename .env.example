# Copy this file to .env if you want to override any default:
#
#   cp .env.example .env        (macOS / Linux, or Git Bash on Windows)
#   copy .env.example .env      (Windows CMD / PowerShell)
#
# This project needs NO API keys and NO secrets -- everything runs locally on
# your machine. Nothing below is required; src/config.py has working defaults
# for all of it. The file exists so you can repoint the app at a model or
# dataset stored somewhere else without editing any code.
#
# The variables are read by src/config.py. A .env file is picked up
# automatically only if python-dotenv is installed (it is in requirements.txt).
# You can also just set them as normal environment variables instead.

# Training data: a CSV with a 'review' column and a 'label' column.
# DATA_PATH=data/reviews.csv

# Where the trained artifacts are read from and written to.
# MODEL_PATH=models/sentiment_model.joblib
# VECTORIZER_PATH=models/tfidf_vectorizer.joblib

# Port for the Streamlit app (read by Streamlit itself, default 8501).
# STREAMLIT_SERVER_PORT=8501
