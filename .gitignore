# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environment variables (never commit real secrets)
.env

# Downloaded dataset -- rebuild it with `python -m src.download_data`.
# We keep it out of git so the repo stays small and we do not redistribute
# someone else's data. data/sample_reviews.csv IS committed (it is ours).
data/reviews.csv

# Trained artifacts -- rebuild them with `python -m src.train`.
# Model files are binary, change on every run, and bloat git history.
models/*.joblib

# Jupyter
.ipynb_checkpoints/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
